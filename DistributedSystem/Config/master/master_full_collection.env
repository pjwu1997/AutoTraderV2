# Master VM 全量收集配置

# Master 服務配置
MASTER_PORT=8080
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=120

# Master VM 網路設定
MASTER_VM_IP=10.0.1.100  # 替換為實際的 Master VM IP
MASTER_HOSTNAME=master-vm

# MongoDB 配置 (在 Master VM 上)
MONGO_URI=mongodb://0.0.0.0:27017/
MONGO_DB_NAME=trading_data
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=AutoTrader2024!
MONGO_AUTH_SOURCE=admin

# 資料庫使用者 (給 Slaves 使用)
MONGO_TRADER_USER=trader_user
MONGO_TRADER_PASSWORD=trader_pass_2024

# Redis 配置
REDIS_URL=redis://redis:6379

# 全量收集設定
NUM_SLAVES=5
TOTAL_SYMBOLS=ALL  # 收集所有 symbols
SYMBOLS_PER_SLAVE_MAX=100  # 每個 slave 最多處理的 symbols

# API 速率限制設定
RATE_LIMIT_DELAY=0.1  # 請求間隔 (秒)
BATCH_SIZE=15  # 批次處理大小
MAX_RETRIES=3  # 最大重試次數

# Binance API 限制 (每個 IP)
BINANCE_RATE_LIMIT_PER_MINUTE=1200
SAFETY_MARGIN=200  # 安全邊際

# 日誌設定
LOG_LEVEL=INFO
LOG_FILE=/app/logs/master.log

# 監控告警設定
CPU_ALERT_THRESHOLD=80
MEMORY_ALERT_THRESHOLD=80
ERROR_RATE_ALERT_THRESHOLD=5

# 健康檢查設定
HEALTH_CHECK_INTERVAL=30
SLAVE_TIMEOUT_SECONDS=120
AUTO_REBALANCE=true

# 資料保留設定
DATA_RETENTION_DAYS=30
CLEANUP_INTERVAL_HOURS=24