# Master VM 環境配置

# Master 服務配置
MASTER_PORT=8080
HEARTBEAT_INTERVAL=30
HEARTBEAT_TIMEOUT=120

# MongoDB 配置 (共享資料庫)
MONGO_URI=mongodb://shared-mongo:27017/
MONGO_DB_NAME=trading_data
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_password_here

# Redis 配置
REDIS_URL=redis://redis:6379

# Slave VM 端點 (根據實際 IP 調整)
SLAVE_ENDPOINTS=http://slave-1:8081,http://slave-2:8081,http://slave-3:8081,http://slave-4:8081,http://slave-5:8081

# Symbol 分配設定
NUM_SLAVES=5
MAX_SYMBOLS_PER_SLAVE=105
TOTAL_SYMBOLS_LIMIT=526

# Data Collection Settings (1-minute precision)
TIMEFRAME=1m
DATA_PRECISION=1m
KLINE_INTERVAL=1m

# 日誌設定
LOG_LEVEL=INFO
LOG_FILE=/app/logs/master.log