FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    netcat-openbsd \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy unified requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install additional WebSocket-specific dependencies
RUN pip install --no-cache-dir websocket-client apscheduler

# Copy WebSocket modules
COPY SlaveVM/websockets/ websockets/

# Set environment variables
ENV PYTHONPATH="/app:/app/websockets"
ENV PYTHONUNBUFFERED=1

# Default configuration
ENV LIQUIDATION_WS_URL="wss://fstream.binance.com/ws/!forceOrder@arr"
ENV LIQUIDATION_CLEANUP_MINUTES=5
ENV LIQUIDATION_RECONNECT_INTERVAL=86100

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8083/health', timeout=5)" || exit 1

# Startup command
CMD ["python", "websockets/liquidation_websocket.py"]