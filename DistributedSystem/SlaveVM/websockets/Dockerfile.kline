FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    netcat-openbsd \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy unified requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install additional WebSocket-specific dependencies
RUN pip install --no-cache-dir websockets apscheduler

# Copy WebSocket modules
COPY SlaveVM/websockets/ websockets/

# Set environment variables
ENV PYTHONPATH="/app:/app/websockets"
ENV PYTHONUNBUFFERED=1

# Default configuration
ENV KLINE_INTERVAL=1m
ENV KLINE_SPOT_WS_URL="wss://stream.binance.com:9443/ws/{streams}"
ENV KLINE_FUTURES_WS_URL="wss://fstream.binance.com/ws/{streams}"

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8082/health', timeout=5)" || exit 1

# Startup command
CMD ["python", "websockets/kline_websocket.py"]